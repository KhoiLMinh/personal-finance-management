{
  "info": {
    "name": "FinManage – Regression (tự chứa)",
    "description": "Tự đăng ký user mới mỗi lần chạy, dùng ID trả về, có assertion cho từng request. Chạy: newman run regression.postman_collection.json --env-var baseUrl=http://localhost:8080/api/v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// local yyyy-MM-dd (toISOString would shift the day in UTC+7)",
          "const d = new Date(); const p = n => String(n).padStart(2, '0');",
          "pm.collectionVariables.set('today', `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`);",
          "pm.collectionVariables.set('month', d.getMonth() + 1); pm.collectionVariables.set('year', d.getFullYear());",
          "if (!pm.collectionVariables.get('run')) pm.collectionVariables.set('run', Date.now().toString(36));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "badToken",
      "value": "not.a.jwt"
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Đăng ký user A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"nm_a_{{run}}\",\n  \"email\": \"nm_a_{{run}}@newman.local\",\n  \"password\": \"Passw0rd!\",\n  \"fullName\": \"Newman A\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Đăng nhập user A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"nm_a_{{run}}\",\n  \"password\": \"Passw0rd!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"Có token và user\", () => { pm.expect(b.token).to.be.a(\"string\"); pm.expect(b.user.username).to.eql(pm.variables.replaceIn(\"nm_a_{{run}}\")); });",
                  "pm.collectionVariables.set('tokenA', b.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Đăng ký user B",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"nm_b_{{run}}\",\n  \"email\": \"nm_b_{{run}}@newman.local\",\n  \"password\": \"Passw0rd!\",\n  \"fullName\": \"Newman B\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Đăng nhập user B",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"nm_b_{{run}}\",\n  \"password\": \"Passw0rd!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"Có token và user\", () => { pm.expect(b.token).to.be.a(\"string\"); pm.expect(b.user.username).to.eql(pm.variables.replaceIn(\"nm_b_{{run}}\")); });",
                  "pm.collectionVariables.set('tokenB', b.token);"
