        {
          "name": "Không có token → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/wallets"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Token sai → 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{badToken}}"
              }
            ],
            "url": "{{baseUrl}}/wallets"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "USER gọi API admin → 403 (không phải 401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{baseUrl}}/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sai mật khẩu bị từ chối",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"nm_a_{{run}}\",\n  \"password\": \"wrong\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"4xx, không có token\", () => { pm.expect(pm.response.code).to.be.within(400, 499); pm.expect(pm.response.text()).to.not.include(\"token\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Ví & danh mục",
      "item": [
        {
          "name": "Tạo ví 1.000.000",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/wallets",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Newman ví {{run}}\",\n  \"balance\": 1000000,\n  \"icon\": \"Wallet\",\n  \"color\": \"#2348c9\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const w = pm.response.json();",
                  "pm.test(\"balance và quyền OWNER\", () => { pm.expect(Number(w.balance)).to.eql(1000000); pm.expect(w.myPermission).to.eql(\"OWNER\"); });",
                  "pm.collectionVariables.set('walletId', w.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sửa ví không đổi được số dư",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/wallets/{{walletId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Newman ví sửa {{run}}\",\n  \"balance\": 999999999\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"balance giữ nguyên\", () => pm.expect(Number(pm.response.json().balance)).to.eql(1000000));"
                ]
              }
            }
          ]
        },
        {
          "name": "Lấy danh mục (đã clone mặc định)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{baseUrl}}/categories"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const cs = pm.response.json();",
                  "const exp = cs.find(c => c.type === \"EXPENSE\" && !c.parentId); const inc = cs.find(c => c.type === \"INCOME\");",
                  "pm.test(\"Có danh mục thu và chi\", () => { pm.expect(exp).to.be.an(\"object\"); pm.expect(inc).to.be.an(\"object\"); });",
                  "pm.collectionVariables.set('expenseCat', exp.id); pm.collectionVariables.set('incomeCat', inc.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "User B không sửa được ví của A",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenB}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/wallets/{{walletId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"hack\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
