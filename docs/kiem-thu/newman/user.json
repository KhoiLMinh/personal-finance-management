  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1", "type": "string" },
    { "key": "token", "value": "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJ1c2VyX2RlbW8iLCJ1c2VySWQiOjMsInJvbGUiOiJVU0VSIiwiaWF0IjoxNzg4NTgwMzk0LCJleHAiOjE3ODg1ODM5OTR9.-505GwurtyLRryVD7dC574M-Q2v2cIfRqX_ZHDR01RE", "type": "string" }
