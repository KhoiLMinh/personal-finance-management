  "item": [
    {
      "name": "1. Auth & Profile",
      "item": [
        {
          "name": "Login",
          "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n    \"username\": \"user_demo\",\n    \"password\": \"123\"\n}" }, "url": { "raw": "{{baseUrl}}/auth/login", "host": [ "{{baseUrl}}" ], "path": [ "auth", "login" ] } }
        },
        {
          "name": "Register",
          "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n    \"username\": \"user_03\",\n    \"email\": \"user03@gmail.com\",\n    \"password\": \"123\",\n    \"fullName\": \"User 03\"\n}" }, "url": { "raw": "{{baseUrl}}/auth/register", "host": [ "{{baseUrl}}" ], "path": [ "auth", "register" ] } }
        },
        {
          "name": "Change Password",
          "request": { "method": "PUT", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n    \"oldPassword\": \"123\",\n    \"newPassword\": \"456\"\n}" }, "url": { "raw": "{{baseUrl}}/auth/change-password", "host": [ "{{baseUrl}}" ], "path": [ "auth", "change-password" ] } }
        },
        {
          "name": "Google Login",
          "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n    \"googleToken\": \"Mã_Token_Từ_Google_\"\n}" }, "url": { "raw": "{{baseUrl}}/auth/google", "host": [ "{{baseUrl}}" ], "path": [ "auth", "google" ] } }
        },
        {
          "name": "Get Profile",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/users/profile", "host": [ "{{baseUrl}}" ], "path": [ "users", "profile" ] } }
        },
        {
          "name": "Update Profile",
          "request": { "method": "PATCH", "body": { "mode": "formdata", "formdata": [ { "key": "fullName", "value": "Tên Mới", "type": "text" }, { "key": "avatar", "type": "file", "src": "" } ] }, "url": { "raw": "{{baseUrl}}/users/profile", "host": [ "{{baseUrl}}" ], "path": [ "users", "profile" ] } }
        }
      ]
    },
    {
      "name": "2. Wallets",
      "item": [
        { "name": "Get Wallets", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/wallets", "host": [ "{{baseUrl}}" ], "path": [ "wallets" ] } } },
        { "name": "Create Wallet", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n    \"name\": \"Ví Trả Sau\",\n    \"balance\": 1000000.0,\n    \"icon\": \"CreditCard\",\n    \"color\": \"#f59e0b\"\n}" }, "url": { "raw": "{{baseUrl}}/wallets", "host": [ "{{baseUrl}}" ], "path": [ "wallets" ] } } },
        { "name": "Update Wallet", "request": { "method": "PUT", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n    \"name\": \"Ví Tiền Mặt (Sửa)\",\n    \"icon\": \"Wallet\",\n    \"color\": \"#10b981\"\n}" }, "url": { "raw": "{{baseUrl}}/wallets/1", "host": [ "{{baseUrl}}" ], "path": [ "wallets", "1" ] } } },
        { "name": "Delete Wallet", "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/wallets/1", "host": [ "{{baseUrl}}" ], "path": [ "wallets", "1" ] } } },
        { "name": "Get Wallet Members", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/wallets/1/members", "host": [ "{{baseUrl}}" ], "path": [ "wallets", "1", "members" ] } } },
        { "name": "Share Wallet", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n    \"email\": \"user_1@example.com\",\n    \"permission\": \"VIEW\"\n}" }, "url": { "raw": "{{baseUrl}}/wallets/1/members/share", "host": [ "{{baseUrl}}" ], "path": [ "wallets", "1", "members", "share" ] } } }
      ]
    },
    {
