        { "name": "AI Chat", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n    \"message\": \"Tháng này tôi tiêu bao nhiêu?\"\n}" }, "url": { "raw": "{{baseUrl}}/ai/chat", "host": [ "{{baseUrl}}" ], "path": [ "ai", "chat" ] } } },
