        { "name": "Create Category Rule", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n    \"keyword\": \"Shopee\",\n    \"priority\": 1\n}" }, "url": { "raw": "{{baseUrl}}/categories/1/rules", "host": [ "{{baseUrl}}" ], "path": [ "categories", "1", "rules" ] } } },
        { "name": "Delete Category Rule", "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/categories/1/rules/1", "host": [ "{{baseUrl}}" ], "path": [ "categories", "1", "rules", "1" ] } } }
