        { "name": "Create Transaction", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n    \"walletId\": 1,\n    \"categoryId\": 1,\n    \"amount\": 75000.0,\n    \"type\": \"EXPENSE\",\n    \"date\": \"2026-09-05\",\n    \"description\": \"Test Giao Dịch\"\n}" }, "url": { "raw": "{{baseUrl}}/transactions", "host": [ "{{baseUrl}}" ], "path": [ "transactions" ] } } },
        { "name": "Update Transaction", "request": { "method": "PUT", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n    \"walletId\": 1,\n    \"categoryId\": 1,\n    \"amount\": 80000.0,\n    \"type\": \"EXPENSE\",\n    \"date\": \"2026-09-05\",\n    \"description\": \"Sửa Giao Dịch\"\n}" }, "url": { "raw": "{{baseUrl}}/transactions/1", "host": [ "{{baseUrl}}" ], "path": [ "transactions", "1" ] } } },
